# Notion
NOTION_TOKEN=secret_xxx                      # Notion integration token (Internal Integration Secret)
NOTION_VIDEOS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxx  # Videos database ID (from its URL)

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxx      # the spreadsheet ID from its URL

# Security — Vercel auto-sends this as a Bearer token when the cron fires
CRON_SECRET=choose-a-long-random-string
